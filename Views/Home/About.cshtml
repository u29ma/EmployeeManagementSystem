@{
    ViewData["Title"] = "About Us";
}

<style>
    .about-container {
        max-width: 1100px;
        margin: 60px auto;
        padding: 30px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    }

    .about-title {
        text-align: center;
        color: #ff7a00;
        margin-bottom: 20px;
    }

    .about-section {
        margin-bottom: 20px;
        color: #444;
        line-height: 1.6;
    }

    .highlight {
        color: #ff7a00;
        font-weight: bold;
    }
</style>

<div class="about-container">
    <h2 class="about-title">About EMS</h2>

    <div class="about-section">
        <p>
            <span class="highlight">Employee Management System (EMS)</span> is designed to simplify
            and automate employee-related tasks such as attendance, payroll, and leave management.
        </p>
    </div>

    <div class="about-section">
        <p>
            Our system helps organizations efficiently manage employee records, track performance,
            and streamline HR processes with a user-friendly interface.
        </p>
    </div>

    <div class="about-section">
        <p>
            <span class="highlight">Key Features:</span>
            <ul>
                <li>Employee Management</li>
                <li>Attendance Tracking</li>
                <li>Leave Management</li>
                <li>Payroll System</li>
            </ul>
        </p>
    </div>

    <div class="about-section">
        <p>
            This project is built using <span class="highlight">ASP.NET Core MVC</span> with a focus on
            clean design and easy usability.
        </p>
    </div>
</div>
