@{
    ViewData["Title"] = "Home Page";
}

<link rel="stylesheet" href="~/css/home.css"/>

<!-- HERO SECTION -->

<div class="hero">

    <div class="hero-content">

        <h2>Manage Your Workforce</h2>

        <h1 style="color: orange;">
            Efficiently & Seamlessly
        </h1>

        <p>
            Simplify employee management, attendance, payroll,
            and leave tracking in one centralized platform.
        </p>

        <div class="buttons">
            <a href="/Account/Login" class="btn-login">
               Login
            </a>
        </div>

    </div>

</div>


<!-- FEATURES SECTION -->

<section class="features">

    <div class="features-header">

        <h3>Our Features</h3>

        <h2>A better way to manage your workforce</h2>

        <p>
            Everything you need to run your HR operations smoothly
            and efficiently, all in one place.
        </p>

    </div>

    <div class="container">

        <div class="feature-box">

            <div class="icon">👥</div>

            <div>
                <h3>Employee Management</h3>

                <p>
                    Keep employee records organized. Manage profiles,
                    roles, and departments efficiently.
                </p>
            </div>

        </div>

        <div class="feature-box">

            <div class="icon">📄</div>

            <div>
                <h3>Leave Management</h3>

                <p>
                    Automate leave requests and approvals while
                    tracking leave balances easily.
                </p>
            </div>

        </div>

        <div class="feature-box">

            <div class="icon">💰</div>

            <div>
                <h3>Payroll Processing</h3>

                <p>
                    Automate salary calculations and generate
                    payslips quickly and accurately.
                </p>
            </div>

        </div>

        <div class="feature-box">

            <div class="icon">⏱</div>

            <div>
                <h3>Attendance Tracking</h3>

                <p>
                    Monitor employee attendance with secure
                    clock-in and clock-out systems.
                </p>
            </div>

        </div>

    </div>

</section>


