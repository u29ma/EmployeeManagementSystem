@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
@model List<EmployeeManagementSystem.Models.PayrollModel>

<div class="container mt-4">

    <h3 class="mb-3">My Salary</h3>

    <div class="row mb-3">
        <div class="col-md-4">
            <div class="card p-3 text-center">
                <h6>Total Paid</h6>
                <h4>₹ @Model.Where(x => x.Status == "Paid").Sum(x => x.NetSalary)</h4>
            </div>
        </div>
    </div>

    <div class="card shadow-sm p-3">
        <form method="get" class="row mb-3">

            <div class="col-md-3">
                <select name="month" class="form-control">
                    <option value="">All Months</option>
                    <option value="January" selected="@(ViewBag.Month == "January")">January</option>
                    <option value="February" selected="@(ViewBag.Month == "February")">February</option>
                    <option value="March" selected="@(ViewBag.Month == "March")">March</option>
                </select>
            </div>

            <div class="col-md-3">
                <select name="status" class="form-control">
                    <option value="">All</option>

                    <option value="Paid"
                            selected="@(ViewBag.Status == "Paid")">
                        Paid
                    </option>

                    <option value="Pending"
                            selected="@(ViewBag.Status == "Pending")">
                        Pending
                    </option>

                    <option value="Hold"
                            selected="@(ViewBag.Status == "Hold")">
                        Hold
                    </option>
                </select>
            </div>

            <div class="col-md-2">
                <button class="btn btn-primary w-100">Filter</button>
            </div>
            <div class="col-md-2">
                <a href="/Payroll/MySalary" class="btn btn-secondary w-100">
                    Reset
                </a>
            </div>

        </form>

        <table class="table table-hover text-center align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Month</th>
                    <th>Year</th>
                    <th>Net Salary</th>
                    <th>Status</th>
                    <th>Payslip</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <!-- 📅 Month -->
                            <td>@item.SalaryMonth</td>

                            <!-- 📆 Year -->
                            <td>@item.SalaryYear</td>

                            <!-- 💰 Salary -->
                            <td class="fw-bold text-success">
                                ₹ @item.NetSalary
                            </td>

                            <!-- 🟢 Status -->
                            <td>
                                @if (item.Status == "Paid")
                                {
                                    <span class="badge bg-success px-3 py-2">
                                        Paid
                                    </span>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2">
                                        Pending
                                    </span>
                                }
                                else if (item.Status == "Hold")
                                {
                                    <span class="badge bg-danger px-3 py-2">
                                        Hold
                                    </span>
                                }
                            </td>
                           

                            <!-- 📄 Payslip -->
                            <td>

                                @if (item.Status == "Paid")
                                {
                                    <a asp-controller="Reports"
                                           asp-action="Payslip"
                                           asp-route-payrollId="@item.PayrollId"
                                           class="btn btn-sm btn-primary">

                                        View Payslip
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not Available
                                    </span>
                                }

                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-muted py-4">
                            No salary records found
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>
</div>