@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
   
}
@model List<EmployeeManagementSystem.Models.PayrollModel>

<h2>All Payroll</h2>

<a href="/Payroll/CreatePayroll" class="btn btn-primary">Create Payroll</a>

<table class="table mt-3">
    <tr>
        <th>Employee</th>
        <th>Month</th>
        <th>Year</th>
        <th>Net Salary</th>
        <th>Status</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Employee.EmployeeId</td>
            <td>@item.SalaryMonth</td>
            <td>@item.SalaryYear</td>
            <td>@item.NetSalary</td>
            <td>@item.Status</td>
            <td>
                @if (item.Status != "Approved")
                {
                    <a href="/Payroll/Approve/@item.PayrollId" class="btn btn-success">Approve</a>
                }
            </td>
        </tr>
    }
</table>

