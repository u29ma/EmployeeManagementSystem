@model List<PayrollModel>

<h3>Pending Payroll</h3>

<table class="table">
    <tr>
        <th>Employee</th>
        <th>Amount</th>
        <th>Status</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Employee.FirstName @item.Employee.LastName</td>
            <td>@item.NetSalary</td>
            <td><span class="badge bg-warning">Pending</span></td>
        </tr>
    }
</table>

