@model EmployeeManagementSystem.Models.ProfileViewModel

@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
    ViewData["Title"] = "My Profile";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

<style>

    .profile-card {
        border-radius: 20px;
        border: none;
        overflow: hidden;
    }

    .profile-header {
        background: linear-gradient(45deg, #4e73df, #224abe);
        color: white;
        padding: 40px 20px;
        text-align: center;
    }

    .profile-img {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        border: 5px solid white;
        object-fit: cover;
        margin-bottom: 15px;
    }

    .info-card {
        border-radius: 15px;
        border: none;
        transition: 0.3s;
    }

        .info-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 18px rgba(0,0,0,0.1);
        }

    .table th {
        width: 220px;
        background-color: #f8f9fa;
    }

</style>

<div class="container mt-4">

    <div class="card shadow-lg profile-card">

        <!-- Header -->
        <div class="profile-header">

            <img src="~/images/user.png" class="profile-img" alt="Profile" />

            <h3>
                @Model.Employee.FirstName @Model.Employee.LastName
            </h3>

            <p class="mb-0">
                @Model.Employee.DesignationName
            </p>

        </div>

        <!-- Body -->
        <div class="card-body p-4">

            <div class="row">

                <!-- Left Side -->
                <div class="col-md-8">

                    <h4 class="mb-4">
                        Personal Information
                    </h4>

                    <table class="table table-bordered">

                        <tr>
                            <th>
                                <i class="fas fa-envelope me-2"></i>
                                Email
                            </th>

                            <td>
                                @Model.Email
                            </td>
                        </tr>

                        <tr>
                            <th>
                                <i class="fas fa-phone me-2"></i>
                                Phone
                            </th>

                            <td>
                                @Model.Employee.Phone
                            </td>
                        </tr>

                        <tr>
                            <th>
                                <i class="fas fa-building me-2"></i>
                                Department
                            </th>

                            <td>
                                @Model.Employee.DepartmentName
                            </td>
                        </tr>

                        <tr>
                            <th>
                                <i class="fas fa-user-tie me-2"></i>
                                Designation
                            </th>

                            <td>
                                @Model.Employee.DesignationName
                            </td>
                        </tr>

                        <tr>
                            <th>
                                <i class="fas fa-calendar me-2"></i>
                                Joining Date
                            </th>

                            <td>
                                @Model.Employee.JoiningDate.ToString("dd MMM yyyy")
                            </td>
                        </tr>

                        <tr>
                            <th>
                                <i class="fas fa-circle-check me-2"></i>
                                Status
                            </th>

                            <td>
                                <span class="badge bg-success">
                                    Active
                                </span>
                            </td>
                        </tr>

                    </table>

                </div>

                <!-- Right Side -->
                <div class="col-md-4">

                    <h4 class="mb-4">
                        Quick Summary
                    </h4>

                    <!-- Present -->
                    <div class="card info-card bg-success text-white p-3 mb-3">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>
                                <h6>Present Days</h6>
                                <h3>@Model.PresentDays</h3>
                            </div>

                            <i class="fas fa-user-check fa-2x"></i>

                        </div>

                    </div>

                    <!-- Leaves -->
                    <div class="card info-card bg-warning text-white p-3 mb-3">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>
                                <h6>Total Leaves</h6>
                                <h3>@Model.TotalLeaves</h3>
                            </div>

                            <i class="fas fa-calendar-times fa-2x"></i>

                        </div>

                    </div>

                    <!-- Payroll -->
                    <div class="card info-card bg-primary text-white p-3">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>
                                <h6>Payroll Generated</h6>
                                <h3>@Model.PayrollGenerated</h3>
                            </div>

                            <i class="fas fa-money-check-dollar fa-2x"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>