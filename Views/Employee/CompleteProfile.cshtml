@model EmployeeManagementSystem.Models.EmployeeModel

<div class="container mt-5">
    <div class="card shadow-lg p-4">

        <h3 class="mb-4 text-center">🧑‍💼 Complete Your Profile</h3>

        <form asp-action="CompleteProfile" method="post">

            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="EmployeeId" />
            <div class="row">
                <!-- First Name -->
                <div class="col-md-6 mb-3">
                    <label>First Name</label>
                    <input asp-for="FirstName" class="form-control" />
                </div>
                <!-- Last Name -->
                <div class="col-md-6 mb-3">
                    <label>Last Name</label>
                    <input asp-for="LastName" class="form-control" />
                </div>
                <!-- Gender -->
                <div class="col-md-6 mb-3">
                    <label>Gender</label>
                    <select asp-for="Gender" class="form-control">
                        <option value="">-- Select Gender --</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>
                <!-- Phone -->
                <div class="col-md-6 mb-3">
                    <label>Phone</label>
                    <input asp-for="Phone" class="form-control" />
                </div>
                <!-- Email -->
                <div class="col-md-6 mb-3">
                    <label>Email</label>
                    <input asp-for="Email" class="form-control" />
                </div>
                <!-- Password -->
                <div class="col-md-6 mb-3">
                    <label>Password</label>
                    <input asp-for="Password" type="password" class="form-control" />
                </div>
                <!-- Department -->
                <div class="col-md-6 mb-3">
                    <label>Department</label>
                    <select asp-for="DepartmentId" class="form-control">
                        <option value="1">IT Department</option>
                        <option value="2">Admin</option>
                        <option value="3">HR</option>
                        <option value="4">Software Developer</option>
                    </select>
                </div>

                <!-- Designation -->
                <div class="col-md-6 mb-3">
                    <label>Designation</label>
                    <input asp-for="Designation" class="form-control" />
                </div>

                <!-- Salary -->
                <div class="col-md-6 mb-3">
                    <label>Salary</label>
                    <input asp-for="Salary" class="form-control" />
                </div>
                <!-- Address -->
                <div class="col-md-12 mb-3">
                    <label>Address</label>
                    <textarea asp-for="Address" class="form-control"></textarea>
                </div>
            </div>
            <div class="text-center mt-4">
                <button class="btn btn-success w-50">Save Profile</button>
            </div>

        </form>

    </div>
</div>

