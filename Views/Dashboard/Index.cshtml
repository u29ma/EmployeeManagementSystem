@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
    ViewData["Title"] = "Employee Dashboard";
}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
    .card {
    border-radius: 12px;
    border: none;
    }

</style>
<div class="container-fluid mt-4">
    <h3>Welcome, @Context.Session.GetString("UserName")!</h3>
    <p class="text-muted">Your personal dashboard</p>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white p-3">
                <h6>Total Leaves</h6>
                <h3>@Model.TotalLeaves</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-success text-white p-3">
                <h6>Approved</h6>
                <h3>@Model.ApprovedLeaves</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white p-3">
                <h6>Pending</h6>
                <h3>@Model.PendingLeaves</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-info text-white p-3">
                <h6>Present Days</h6>
                <h3>@Model.PresentDays</h3>
            </div>
        </div>

    </div>
   @*  <!-- Chart -->
    <div class="card p-3 shadow-sm">
        <h5>My Leave Overview</h5>
        <div style="height:300px;">
            <canvas id="empChart"></canvas>
        </div>
    </div> *@
    <div class="row mt-4">

        <!-- Leave Chart -->
        <div class="col-md-6">
            <div class="card p-3 shadow-sm">
                <h6>Leave Overview</h6>
                <div style="height:250px;">
                    <canvas id="empChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Attendance Chart -->
        <div class="col-md-6">
            <div class="card p-3 shadow-sm">
                <h6>Attendance Overview</h6>
                <div style="height:250px;">
                    <canvas id="attendanceChart"></canvas>
                </div>
            </div>
        </div>

    </div>

    <div class="row mt-4">

        <!-- Salary Chart -->
        <div class="col-md-6">
            <div class="card p-3 shadow-sm">
                <h6>Salary Overview</h6>
                <div style="height:250px;">
                    <canvas id="salaryChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Optional Empty Card -->
        <div class="col-md-6">
            <div class="card p-3 shadow-sm text-center">
                <h6>More Insights</h6>
                <p class="text-muted">Coming soon...</p>
            </div>
        </div>

    </div>



</div>

<script>
    fetch('/Dashboard/GetLeaveChart')
    .then(res => res.json())
    .then(data => {

    new Chart(document.getElementById("empChart"), {
    type: 'doughnut',
    data: {
    labels: ['Approved', 'Pending'],
    datasets: [{
    data: [data.approved, data.pending],
    backgroundColor: [
    '#28a745',   // green
    '#ffc107'    // yellow
    ]
    }]
    },
    options: {
    cutout: '65%',
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
    legend: {
    position: 'bottom'
    }
    }
    }
    });


    });
</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {

    // 🔹 Leave Chart
    fetch('/Dashboard/GetLeaveChart')
    .then(res => res.json())
    .then(data => {

    new Chart(document.getElementById("empChart"), {
    type: 'doughnut',
    data: {
    labels: ['Approved', 'Pending'],
    datasets: [{
    data: [data.approved, data.pending],
    backgroundColor: ['#28a745', '#ffc107']
    }]
    },
    options: {
    cutout: '65%',
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
    legend: { position: 'bottom' }
    }
    }
    });
    });

    // 🔹 Attendance Chart
    fetch('/Dashboard/GetAttendanceChart')
    .then(res => res.json())
    .then(data => {

    new Chart(document.getElementById("attendanceChart"), {
    type: 'pie',
    data: {
    labels: ['Present', 'Absent'],
    datasets: [{
    data: [data.present, data.absent],
    backgroundColor: ['#20c997', '#dc3545']
    }]
    },
    options: {
    responsive: true,
    maintainAspectRatio: false
    }
    });

    });

    // 🔹 Salary Chart
    fetch('/Dashboard/GetSalaryChart')
    .then(res => res.json())
    .then(data => {

    new Chart(document.getElementById("salaryChart"), {
    type: 'doughnut',
    data: {
    labels: ['Paid', 'Pending'],
    datasets: [{
    data: [data.paid, data.pending],
    backgroundColor: ['#0d6efd', '#ffc107']
    }]
    },
    options: {
    cutout: '60%',
    responsive: true,
    maintainAspectRatio: false
    }
    });

    });

    });
</script>


