@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
    ViewData["Title"] = "Employee Dashboard";
}

@model EmployeeDashboardModel

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>

    .dashboard-card {
        border-radius: 15px;
        border: none;
        transition: 0.3s;
        overflow: hidden;
    }

    .dashboard-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 6px 18px rgba(0,0,0,0.15);
    }

    .dashboard-card i {
        font-size: 32px;
        opacity: 0.8;
    }

    .dashboard-card h3 {
        font-weight: bold;
        margin-top: 10px;
    }

    .chart-card {
        border-radius: 15px;
        border: none;
    }

    .recent-card {
        border-radius: 15px;
        border: none;
    }
    .btn-orange {
        background:darkorange;
        color:white;
    }
    .btn-orange:hover {
        background: orangered;
        color: white;
    }

</style>

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center">

        <div>
            <h3>
                Welcome,
                @Context.Session.GetString("UserName") 👋
            </h3>

            <p class="text-muted">
                Your personal dashboard
            </p>
        </div>

        <div>
            <a asp-controller="LeaveManagement"
               asp-action="ApplyLeave"
               class="btn btn-orange">
                Apply Leave
            </a>
        </div>

    </div>

    <!-- Main Cards -->
    <div class="row g-4 mt-1">

        <!-- Total Leaves -->
        <div class="col-md-3">

            <div class="card dashboard-card bg-primary text-white p-3">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <h6>Total Leaves</h6>
                        <h3>@Model.TotalLeaves</h3>
                    </div>

                    <i class="fas fa-calendar-alt"></i>

                </div>

            </div>

        </div>

        <!-- Approved -->
        <div class="col-md-3">

            <div class="card dashboard-card bg-success text-white p-3">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <h6>Approved</h6>
                        <h3>@Model.ApprovedLeaves</h3>
                    </div>

                    <i class="fas fa-check-circle"></i>

                </div>

            </div>

        </div>

        <!-- Pending -->
        <div class="col-md-3">

            <div class="card dashboard-card bg-warning text-white p-3">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <h6>Pending</h6>
                        <h3>@Model.PendingLeaves</h3>
                    </div>

                    <i class="fas fa-clock"></i>

                </div>

            </div>

        </div>

        <!-- Present Days -->
        <div class="col-md-3">

            <div class="card dashboard-card bg-info text-white p-3">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <h6>Present Days</h6>
                        <h3>@Model.PresentDays</h3>
                    </div>

                    <i class="fas fa-user-check"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Charts -->
    <div class="row mt-4">

        <!-- Leave Chart -->
        <div class="col-md-6">

            <div class="card chart-card p-3 shadow-sm">

                <h5>Leave Overview</h5>

                <div style="height:250px;">
                    <canvas id="empChart"></canvas>
                </div>

            </div>

        </div>

        <!-- Attendance Chart -->
        <div class="col-md-6">

            <div class="card chart-card p-3 shadow-sm">

                <h5>Attendance Overview</h5>

                <div style="height:250px;">
                    <canvas id="attendanceChart"></canvas>
                </div>

            </div>

        </div>

    </div>

    <!-- Second Row -->
    <div class="row mt-4">

        <!-- Salary Chart -->
        <div class="col-md-6">

            <div class="card chart-card p-3 shadow-sm">

                <h5>Salary Overview</h5>

                <div style="height:250px;">
                    <canvas id="salaryChart"></canvas>
                </div>

            </div>

        </div>

        <!-- Recent Activities -->
        <div class="col-md-6">

            <div class="card recent-card p-3 shadow-sm">

                <h5>Recent Activities</h5>

                <ul class="list-group list-group-flush">

                    <li class="list-group-item">
                        Leave request submitted
                    </li>

                    <li class="list-group-item">
                        Attendance marked successfully
                    </li>

                    <li class="list-group-item">
                        Payroll generated
                    </li>

                </ul>

            </div>

        </div>

    </div>

    <!-- Footer -->
    <div class="mt-4">

        <p class="text-muted">
            Last updated:
            @DateTime.Now.ToString("dd MMM yyyy hh:mm tt")
        </p>

    </div>

</div>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        // 🔹 Leave Chart
        fetch('/Dashboard/GetLeaveChart')
            .then(res => res.json())
            .then(data => {

                new Chart(document.getElementById("empChart"), {

                    type: 'doughnut',

                    data: {
                        labels: ['Approved', 'Pending'],
                        datasets: [{
                            data: [data.approved, data.pending],
                            backgroundColor: [
                                '#28a745', '#ffc107'
                            ]
                        }]
                    },

                    options: {
                        cutout: '65%',
                        responsive: true,
                        maintainAspectRatio: false,

                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        }
                    }

                });

            });

        // 🔹 Attendance Chart
        fetch('/Dashboard/GetAttendanceChart')
            .then(res => res.json())
            .then(data => {

                new Chart(document.getElementById("attendanceChart"), {

                    type: 'pie',

                    data: {
                        labels: ['Present', 'Absent'],
                        datasets: [{
                            data: [data.present, data.absent],
                            backgroundColor: [
                                '#20c997', '#dc3545'
                            ]
                        }]
                    },

                    options: {
                        responsive: true,
                        maintainAspectRatio: false,

                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        }
                    }

                });

            });

        // 🔹 Salary Chart
        fetch('/Dashboard/GetSalaryChart')
            .then(res => res.json())
            .then(data => {

                new Chart(document.getElementById("salaryChart"), {

                    type: 'doughnut',

                    data: {
                        labels: ['Paid', 'Pending'],
                        datasets: [{
                            data: [data.paid, data.pending],
                            backgroundColor: [
                               '#0d6efd', '#ffc107'
                            ]
                        }]
                    },

                    options: {
                        cutout: '60%',
                        responsive: true,
                        maintainAspectRatio: false,

                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        }
                    }

                });

            });

    });

</script>