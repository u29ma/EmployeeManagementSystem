<!DOCTYPE html>

<html>
<head>
   
    

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <title>@ViewBag.Title</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/layout1.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EmployeeManagementSystem.styles.css" asp-append-version="true" />

</head>
<body>
    @{
        var role = Context.Session.GetString("Role");
        var userName = Context.Session.GetString("UserName");
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();
    
    }

    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow fixed-top">
        <div class="container-fluid">
            <div style="margin-left:50px;">
                <img src="~/images/Logo1.png" style=" width:100px;height:40px;margin-left:40px;" />
                <p style="color:orangered;font-size:small;font-family:Arial;">Employee Management System</p>
            </div>
           
            <div class="auth-buttons">
                @* <a href="/Employee/Create" class="btn btn-warning text-white">+ Add New Employee</a> *@
                @* <a href="/Account/Logout" class="btn btn-danger text-white">Logout</a> *@
                <form asp-controller="Account" asp-action="Logout" method="post">
                              
                    <button type="submit" class="btn btn-danger text-white">

                        <i class="fas fa-sign-out-alt me-2"></i>
                        Logout

                    </button>

                </form>
                <!-- Notification -->
                <div class="icon-btn">
                    <i class="fas fa-bell"></i>
                </div>
                <!-- Profile -->
                <div class="dropdown">
                    <button class="btn btn-warning rounded-circle dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            style="width:45px; height:45px;">

                        @(string.IsNullOrEmpty(userName)
                     ? "U"
                     : userName.Substring(0, 1).ToUpper())

                    </button>

                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <!-- User Header -->
                        <li class="dropdown-header text-center">

                            <strong>
                                Welcome, @userName
                            </strong>
                            <br />

                            <span class="text-muted small">
                                @role
                            </span>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item"
                                   asp-controller="Employee"
                                   asp-action="Profile">

                                <i class="fas fa-user me-2"></i>
                                My Profile

                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item"
                                   asp-controller="Account"
                                   asp-action="ChangePassword">

                                <i class="fas fa-key me-2"></i>
                                Change Password

                            </a>
                        </li>

                        <li><hr class="dropdown-divider"></li>

                        <li>
                            <form asp-controller="Account"  asp-action="Logout" method="post">
                              
                                <button type="submit" class="dropdown-item text-danger border-0 bg-transparent">

                                    <i class="fas fa-sign-out-alt me-2"></i>
                                    Logout

                                </button>

                            </form>
                        </li>

                    </ul>

                </div>
                
            </div>
        </div>
    </nav>
    <div class="d-flex">
        <div class="sidebar position-fixed">

            <h3 style="color:orangered">Employee Management System</h3>
            @if (role == "Admin")
            {
                <a href="/AdminDashboard"
                       class="@(controller == "AdminDashboard"
                              ? "active" : "")">

                    <i class="fa fa-home"></i> Dashboard

                </a>
            }
            else
            {
                <a href="/Dashboard"
                       class="@(controller == "Dashboard"
                              ? "active" : "")">

                    <i class="fa fa-home"></i> Dashboard

                </a>
            }

            @* <a href="#" class="active"><i class="fa fa-home"></i>   Dashboard</a> *@
            @if (role == "Admin")
            {
                <a asp-controller="Employee"
                       asp-action="Index"
                       class="@(controller == "Employee" ? "active" : "")">

                    <i class="fa fa-users"></i> Employees

                </a>
                <a asp-controller="Department"
                       asp-action="Index"
                       class="@(controller == "Department"
                              ? "active" : "")">

                    <i class="fa fa-building"></i> Departments

                </a>
                @*  <a asp-controller="Employee" asp-action="Index"><i class="fa fa-users"></i> Employees</a> *@
                @*  <a asp-controller="Department" asp-action="Index"><i class="fa fa-building"></i> Departments</a> *@
            }
         
            @* <a href="/LeaveManagement/AllLeaves"><i class="fa fa-calendar"></i> Leave Management</a> *@
            @if (role == "Admin")
            {
                <a asp-controller="LeaveManagement" asp-action="AllLeaves"> <i class="fa fa-calendar"></i>   Leave Management</a>
            }
            else
            {
                <a asp-controller="LeaveManagement" asp-action="Index"> <i class="fa fa-calendar"></i>   View Leaves</a>
            }

            @if (role == "Admin")
            {
                <a asp-controller="Payroll"
                       asp-action="Index"
                       class="@(controller == "Payroll"
                              ? "active" : "")">

                    <i class="fa fa-money-bill"></i> Payroll Management

                </a>
                @* <a href="/Payroll/Index"><i class="fa fa-money-bill"></i>   Payroll Management</a> *@
            }
            else
            {
                <a asp-controller="Payroll"
                       asp-action="MySalary"
                       class="@(controller == "Payroll"
                              ? "active" : "")">

                    <i class="fa fa-money-bill"></i> My Salary

                </a>
                @* <a href="/Payroll/MySalary"><i class="fa fa-money-bill"></i>   My Salary</a> *@
            }

            @if (role == "Admin")
            {
                <a asp-controller="Attendance"
                       asp-action="AllAttendance"
                       class="@(controller == "Attendance"
                              ? "active" : "")">

                    <i class="fa fa-money-bill"></i> Manage Attendance

                </a>
                @*  <a href="/Attendance/AllAttendance"><i class="fa fa-clock"></i>   Manage Attendance</a> *@
            }
            else
            {
                <a asp-controller="Attendance"
                       asp-action="Index"
                       class="@(controller == "Attendance"
                              ? "active" : "")">

                    <i class="fa fa-money-bill"></i> My Attendance

                </a>
                @* <a href="/Attendance/Index"><i class="fa fa-clock"></i>   My Attendance</a> *@
            }

            @if (role == "Admin")
            {
                <a asp-controller="Announcement"
                       asp-action="Index"
                       class="@(controller == "Announcement"
                              ? "active" : "")">

                    <i class="fa fa-money-bill"></i> Manage Announcements

                </a>
                @*  <a href="/Announcement/Index"><i class="fa fa-bullhorn"></i>   Manage Announcements</a> *@
            }
            else
            {
                <a asp-controller="Announcement"
                       asp-action="EmployeeAnnouncements"
                       class="@(controller == "Announcement"
                              ? "active" : "")">

                    <i class="fa fa-money-bill"></i>  View Announcements

                </a>
                @* <a href="/Announcement/EmployeeAnnouncements"><i class="fa fa-bullhorn"></i>   View Announcements</a> *@
            }
           
            @if (role == "Admin")
            {
                <a href="#reportSubMenu"
                       data-bs-toggle="collapse"
                       class="d-flex justify-content-between align-items-center @(controller == "Reports" ? "active" : "")">

                    <span>
                        <i class="fa fa-chart-bar"></i> Reports
                    </span>

                    <i class="fa fa-chevron-down small"></i>
                </a>

                <div class="collapse ps-4 mt-1  @(controller == "Reports" ? "show" : "")" id="reportSubMenu">
                    <a asp-controller="Reports" asp-action="EmployeeReport" class="@(action == "EmployeeReport" ? "active" : "")"><i class="fa fa-file-lines"></i> Employee Report </a>
                    <a asp-controller="Reports" asp-action="PayrollReport" class="@(action == "PayrollReport" ? "active" : "")"><i class="fa fa-money-bill"></i> Payroll Report </a>
                    <a asp-controller="Reports" asp-action="AttendanceReport" class="@(action == "AttendanceReport" ? "active" : "")"><i class="fa fa-clock"></i> Attendance Report</a>
                </div>
            }

        </div>



        <div class="flex-grow-1 p-3 main-content">
            @RenderBody()
        </div>
    </div>
    @RenderSection("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <footer class="text-center mt-4 mb-2 text-muted">
        © 2026 Employee Management System
    </footer>
</body>
</html>
