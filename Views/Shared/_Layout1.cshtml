<!DOCTYPE html>

<html>
<head>
    <style>
          /* Center Menu */
            .nav-links {
                display: flex;
                gap: 30px;
            }

                .nav-links a {
                    text-decoration: none;
                    color:black;
                    font-weight: 500;
                    position: relative;
                }

                    /* Hover effect like your image */
                    .nav-links a:hover {
                        color: #ff7a00;
                    }
                      /* Right Buttons */
            .auth-buttons {
                display: flex;
                align-items: center;
                gap: 20px;
                margin-right: 60px;
            }
            .auth-buttons a {
                color: indianred;
                text-decoration: none;
            }
            .profile {
    width: 40px;
    height: 40px;
    background-color: orange; /* orange theme */
    color: white;
    border-radius: 50%; /* makes it circle */
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 18px;
    cursor: pointer;
}
.profile:hover {
    background-color: #e66a00;
}
.icon-btn {
    width: 40px;
    height: 40px;
    background-color: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
}

.icon-btn i {
    font-size: 18px;
    color: #333;
}
.sidebar {
    width: 250px;    
    height: 100%;
    background: #1e293b;
    color: #fff;
    padding: 20px 0;
    position: fixed;
    top: 105px; /* navbar height */
    left: 0;
}

    .sidebar h3 {
    text-align: center;
    margin-bottom: 25px;
    font-size: 18px;
    color: #facc15;
    }

    .sidebar a {
    display: block;
    padding: 12px 20px;
    color: #cbd5e1;
    text-decoration: none;
    font-size: 14px;
    transition: 0.3s;
    }

    .sidebar a:hover {
    background: #334155;
    color: #fff;
    padding-left: 25px;
    }

    .sidebar a.active {
    background: #f59e0b;
    color: white;
    font-weight: bold;
    }
    
    #employeeSubMenu li a {
        color: #ccc;
        font-size: 14px;
        display: block;
        padding: 5px 0;
    }

    #employeeSubMenu li a:hover {
        color: #fff;
    }
    .main-content {
    margin-left: 250px;
    margin-top: 100px;
    }

</style>

    

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <meta name="viewport" content="width=device-width" />
   @*  <title>@(ViewData["Title"] ?? "Employee Management")</title> *@
    <title>@ViewBag.Title</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* <title>@ViewData["Title"] - EmployeeManagementSystem</title> *@
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EmployeeManagementSystem.styles.css" asp-append-version="true" />

</head>
<body>
    @{
        var role = Context.Session.GetString("Role");
    }

    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow fixed-top">
        <div class="container-fluid">
            <div style="margin-left:50px;">
                     <img src="~/images/Logo1.png" style=" width:100px;height:40px;margin-left:40px;"/>
                     <p style="color:orangered;font-size:small;font-family:Arial;">Employee Management Sysytem</p>
                 </div>
           
                <div class="auth-buttons">
                    @* <a href="/Employee/Create" class="btn btn-warning text-white">+ Add New Employee</a> *@
                     <a href="/Account/Logout" class="btn btn-danger text-white">Logout</a>
                      <!-- Notification -->
                <div class="icon-btn">
                    <i class="fas fa-bell"></i>
                </div>
                 <!-- Profile -->
                <div class="profile">
                    A
                </div>
                
                </div> 
        </div>
    </nav>
    <div class="d-flex">
        <div class="sidebar position-fixed">

            <h3 style="color:orangered">Employee Management System</h3>
            @if(role == "Admin")
            {
                <a href="/AdminDashboard" class="active"><i class="fa fa-home"></i>   Dashboard</a>
            }
            else @*  if (Context.Session.GetString("Role") == "Employee") *@
            {
                <a href="/Dashboard" class="active"><i class="fa fa-home"></i>   Dashboard</a>
            }

            @* <a href="#" class="active"><i class="fa fa-home"></i>   Dashboard</a> *@
            @if (role == "Admin")
            {
                <a asp-controller="Employee" asp-action="Index"><i class="fa fa-users"></i> Employees</a>
                <a asp-controller="Department" asp-action="Index"><i class="fa fa-building"></i> Departments</a>
            }
         
            @* <a href="/LeaveManagement/AllLeaves"><i class="fa fa-calendar"></i> Leave Management</a> *@
            @if(role == "Admin") @* (Context.Session.GetString("Role") == "Admin") *@
            {
                <a asp-controller="LeaveManagement" asp-action="AllLeaves"> <i class="fa fa-calendar"></i>   Leave Management</a>
            }
            else @* if(role == "Employee") *@ @* (Context.Session.GetString("Role") == "Employee") *@
            {
                <a asp-controller="LeaveManagement" asp-action="Index"> <i class="fa fa-calendar"></i>   View Leaves</a>
            }

            @if(role == "Admin")
            {
                <a href="/Payroll/Index"><i class="fa fa-money-bill"></i>   Payroll Management</a>
            }
            else
            {
                <a href="/Payroll/MySalary"><i class="fa fa-money-bill"></i>   My Salary</a>
            }

            @if(role == "Admin")
            {
                <a href="/Attendance/AllAttendance"><i class="fa fa-clock"></i>   Manage Attendance</a>
            }
            else
            {
                <a href="/Attendance/Index"><i class="fa fa-clock"></i>   My Attendance</a>
            }

            @if(role == "Admin")
            {
                <a href="/Announcement/Index"><i class="fa fa-bullhorn"></i>   Manage Announcements</a>
            }
            else
            {
                <a href="/Announcement/EmployeeAnnouncements"><i class="fa fa-bullhorn"></i>   View Announcements</a>
            }

        </div>


        <div class="flex-grow-1 p-3 main-content">
        @RenderBody()
        </div>
  </div>
  @RenderSection("Scripts", required: false)

</body>
</html>
