<!DOCTYPE html>
<html lang="en">
<head>
    <style>
            /* Center menu */
            .menu {
                display: flex;
                list-style: none;
                gap: 30px;
                margin: 0;
                padding: 0;
            }

                .menu li a {
                    text-decoration: none;
                    color: #333;
                    font-weight: 500;
                    transition: 0.3s;
                }
                .menu li a:hover {
    color: orange;
}

/* Right side buttons */
.auth-buttons {
    display: flex;
    align-items: center;
    gap: 25px;
    margin-right: 50px;
}
/* Buttons */
.btn-login {
    text-decoration: none;
    padding: 8px 18px;
    background: crimson;
    border-radius: 10px;
    border: none;
    color: white;
}

.btn-login:hover {
   transform: scale(1.05);
}
.btn-register {
    text-decoration: none;
    padding: 8px 18px;
    background: linear-gradient(to right, orange, gold);
    border-radius: 10px;
    color: white;
}

.btn-register:hover {
    transform: scale(1.05);
}
/* Logout */
.btn-logout {
    color: red;
    text-decoration: none;
}

/* Email */
.user-email {
    font-size: 14px;
    color: #555;
}
    </style>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EmployeeManagementSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EmployeeManagementSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <div style="margin-left:50px;">
                    <img src="~/images/Logo1.png" style=" width:100px;height:40px;margin-left:40px;" />
                    <p style="color:darkorange;font-size:small;font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;">Employee Management Sysytem</p>
                </div>
                
                <div class="header">
                    <!-- CENTER: Menu -->
                    <ul class="menu">
                        <li>
                            <a asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="About">About Us</a>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Contact">Contact Us</a>
                        </li>
                    </ul>
                   @*  <ul class="menu">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                         <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">About Us</a>
                        </li>
                         <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Contect Us</a>
                        </li>
                    </ul> *@
                </div>
                <!-- RIGHT: Auth Buttons -->
                <div class="auth-buttons">

                    @if (Context.Session.GetString("UserId") == null)
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn-login">Login</a>
                        <a asp-controller="Account" asp-action="Register" class="btn-register">Register</a>
                    }
                    else
                    {
                        <span class="user-email">
                            @Context.Session.GetString("UserEmail")
                        </span>

                        <a href="/Account/Logout" class="btn-logout">Logout</a>
                    }

                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
