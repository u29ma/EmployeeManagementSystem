<!DOCTYPE html>
<html lang="en">
<head>
    
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EmployeeManagementSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EmployeeManagementSystem.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <div style="margin-left:50px;">
                    <img src="~/images/Logo1.png" style=" width:100px;height:40px;margin-left:40px;" />
                    <p style="color:orangered;font-size:small;font-family:Arial;">Employee Management System</p>
                </div>
                
                <div class="header">
                    <!-- CENTER: Menu -->
                    <ul class="menu">
                        <li>
                            <a asp-controller="Home" asp-action="Index" class="@(action == "Index" ? "text-warning fw-bold" : "")">
                                Home
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Home"
                                   asp-action="About"
                                   class="@(action == "About" ? "text-warning fw-bold" : "")">

                                About Us

                            </a>
                        </li>
                        <li>
                            <a asp-controller="Home"
                                   asp-action="Contact"
                                   class="@(action == "Contact" ? "text-warning fw-bold" : "")">

                                Contact Us

                            </a>
                        </li>
                    </ul>
                </div>

                <!-- RIGHT: Auth Buttons -->
                <div class="auth-buttons">

                    @if (Context.Session.GetString("UserId") == null)
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn-login">Login</a>
                    }
                    else
                    {
                        <span class="user-email">
                            @Context.Session.GetString("UserEmail")
                        </span>

                        <form asp-controller="Account" asp-action="Logout" method="post">

                            <button type="submit"
                                    class="btn-logout border-0 bg-transparent">

                                Logout

                            </button>

                        </form>
                    }

                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @* <footer class="text-center text-muted py-3 border-top mt-4">
        © 2026 Employee Management System
    </footer> *@
</body>
</html>
