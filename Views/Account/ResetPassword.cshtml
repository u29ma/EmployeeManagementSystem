@model EmployeeManagementSystem.Models.ResetPasswordModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

<style>

    body {
        background-color: #f4f6f9;
    }

    .reset-card {
        border-radius: 20px;
        border: none;
        overflow: hidden;
    }

    .reset-header {
        background: linear-gradient(45deg, #4e73df, #224abe);
        color: white;
        padding: 25px;
        text-align: center;
    }

    .form-control {
        border-radius: 10px;
        height: 45px;
    }

    .btn-reset {
        border-radius: 10px;
        height: 45px;
        font-weight: 600;
    }

</style>

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-5">

            <div class="card shadow-lg reset-card">

                <!-- Header -->
                <div class="reset-header">

                    <h3>
                        <i class="fas fa-lock me-2"></i>
                        Reset Password
                    </h3>

                    <p class="mb-0">
                        Create your new password
                    </p>

                </div>

                <!-- Body -->
                <div class="card-body p-4">

                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Message
                        </div>
                    }

                    <form asp-action="ResetPassword"
                          method="post">

                        <!-- Hidden Fields -->
                        <input asp-for="Email"
                               type="hidden" />

                        <input asp-for="Token"
                               type="hidden" />

                        <!-- New Password -->
                        <div class="mb-3">

                            <label class="form-label">
                                New Password
                            </label>

                            <input asp-for="NewPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter new password" />

                            <span asp-validation-for="NewPassword"
                                  class="text-danger"></span>

                        </div>

                        <!-- Confirm Password -->
                        <div class="mb-3">

                            <label class="form-label">
                                Confirm Password
                            </label>

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Confirm password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger"></span>

                        </div>

                        <!-- Button -->
                        <button type="submit"
                                class="btn btn-primary w-100 btn-reset">

                            <i class="fas fa-key me-2"></i>
                            Reset Password

                        </button>

                    </form>

                    <!-- Back to Login -->
                    <div class="text-center mt-3">

                        <a asp-controller="Account"
                               asp-action="Login"
                               class="text-decoration-none">

                            Back to Login

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}