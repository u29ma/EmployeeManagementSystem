@model EmployeeManagementSystem.Models.ForgotPasswordModel

<div class="container">
    <div class="login-box">
        <div class="left">
            <h2 class="logo">Forgot Password</h2>

            <form method="post" asp-action="ForgotPassword">
                <div class="input-box">
                    <label>Email</label>
                    <input type="email" asp-for="Email" required />
                </div>

                <button type="submit" class="btn">Send Reset Link</button>
            </form>

            @if (ViewBag.Message != null)
            {
                <p style="color:green">@ViewBag.Message</p>
            }
        </div>
    </div>
</div>

