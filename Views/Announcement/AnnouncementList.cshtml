@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
@model List<AnnouncementModel>

<h3>Announcements</h3>

@foreach (var item in Model)
{
    <div class="card mb-3 p-3">
        <h5>@item.Title</h5>
        <p>@item.Message</p>
       @*  <small class="text-muted">@item.CreatedDate</small> *@
    </div>
}

