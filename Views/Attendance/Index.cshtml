@model List<EmployeeManagementSystem.Models.AttendanceModel>

@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<div class="container mt-4">

    <h2 class="mb-3">Attendance</h2>

    <div class="mb-3">
        <button id="btnCheckIn" class="btn btn-success">
            Check In
        </button>

        <button id="btnCheckOut" class="btn btn-danger">
            Check Out
        </button>
    </div>

    <div id="attendanceContainer">

        <partial name="_MyAttendancePartial" model="Model" />

    </div>

</div>

@section Scripts {

    <script>

        function loadAttendance() {

            fetch('/Attendance/GetMyAttendance')
                .then(res => res.text())
                .then(data => {

                    document.getElementById("attendanceContainer").innerHTML = data;
                });
        }

        document.getElementById("btnCheckIn")
            .addEventListener("click", function () {

                fetch('/Attendance/CheckIn')
                    .then(() => {

                        loadAttendance();
                    });
            });

        document.getElementById("btnCheckOut")
            .addEventListener("click", function () {

                fetch('/Attendance/CheckOut')
                    .then(() => {

                        loadAttendance();
                    });
            });

    </script>

}