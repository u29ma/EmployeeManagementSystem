@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

@model List<EmployeeManagementSystem.Models.AttendanceModel>

<h2>My Attendance</h2>

<table class="table">
    <tr>
        <th>Date</th>
        <th>Check In</th>
        <th>Check Out</th>
        <th>Status</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Date.ToShortDateString()</td>
            <td>@item.CheckIn?.ToString(@"hh\:mm")</td>
            <td>@item.CheckOut?.ToString(@"hh\:mm")</td>
            @* <td>@item.CheckIn</td>
            <td>@item.CheckOut</td> *@
            <td>@item.Status</td>
        </tr>
    }
</table>

