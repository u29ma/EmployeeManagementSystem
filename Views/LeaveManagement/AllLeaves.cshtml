@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
}
@model IEnumerable<EmployeeManagementSystem.Models.LeaveManagementModel>


<div class="container mt-4">
    <div class="card shadow-lg p-4">
        <h3 class="text-center text-primary mb-3">Leave Requests</h3>

        <table class="table table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Employee ID</th>
                    <th>Leave Type</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.EmployeeId</td>
                        <td>@item.LeaveType.LeaveName</td>
                        <td>@item.StartDate.ToShortDateString()</td>
                        <td>@item.EndDate.ToShortDateString()</td>
                        <td>@item.Reason</td>

                        <td>
                            @if (item.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (item.Status == "Approved")
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                        </td>

                        <td>
                            <a href="/LeaveManagement/Approve/@item.LeaveId" class="btn btn-success btn-sm">Approve</a>
                            <a href="/LeaveManagement/Reject/@item.LeaveId" class="btn btn-danger btn-sm">Reject</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

