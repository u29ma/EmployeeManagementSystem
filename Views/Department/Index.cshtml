@{
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

@model IEnumerable<EmployeeManagementSystem.Models.DepartmentModel>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>View Departments</h3>
        @* <a href="/Employee/Create" class="btn btn-warning text-white">+ Add New Employee</a> *@
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>DEPARTMENT NAME</th>
                        <th>Description</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.DepartmentName</td>
                            <td>@item.Description</td>
                           
                            <td>
                                <a href="/Employee/Edit/@item.DepartmentId" class="text-primary me-2">Edit</a>
                                <a href="/Employee/Delete/@item.DepartmentId" class="text-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

</div>
